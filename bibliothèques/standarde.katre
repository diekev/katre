inclus "linux.katre"

macro STDIN 0 fin
macro STDOUT 1 fin
macro STDERR 2 fin

// Écris une chaine dans la sortie normale
// La taille de chaine et son adresse doivent être
// sur la pile.
macro écris STDOUT SYS_write appelsys3 fin

// Écris une chaine dans la sortie d'erreur
// La taille de chaine et son adresse doivent être
// sur la pile.
macro écris_erreur STDERR SYS_write appelsys3 fin

// Quitte le programme avec le code de retour se
// trouvant en haut de la pile.
macro quitte SYS_exit appelsys1 fin

macro dup2 enjambe enjambe fin

macro lâche2 lâche lâche fin

macro div divmod lâche fin
macro mod divmod permute lâche fin

macro charge64
    7 + 0
    8 << enjambe , + permute 1 - permute
    8 << enjambe , + permute 1 - permute
    8 << enjambe , + permute 1 - permute
    8 << enjambe , + permute 1 - permute
    8 << enjambe , + permute 1 - permute
    8 << enjambe , + permute 1 - permute
    8 << enjambe , + permute 1 - permute
    8 << enjambe , + permute lâche
fin

macro stocke64
    dup2 255 & . 8 >> permute 1 + permute
    dup2 255 & . 8 >> permute 1 + permute
    dup2 255 & . 8 >> permute 1 + permute
    dup2 255 & . 8 >> permute 1 + permute
    dup2 255 & . 8 >> permute 1 + permute
    dup2 255 & . 8 >> permute 1 + permute
    dup2 255 & . 8 >> permute 1 + permute
    dup2 255 & . lâche lâche
fin

macro taille_chaine_c
    0 permute tantque dup , 0 > fais
        permute 1 + permute 1 +
    fin lâche
fin

// À FAIRE : considère une intrisèque pour obtenir le lieu source
macro À_FAIRE 
    "À FAIRE\n" écris
    1 quitte
fin
