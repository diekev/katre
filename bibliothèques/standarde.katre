// Écris une chaine dans la sortie normale
// La taille de chaine et son adresse doivent être
// sur la pile.
macro écris 1 1 appelsys3 fin

// Écris une chaine dans la sortie d'erreur
// La taille de chaine et son adresse doivent être
// sur la pile.
macro écris_erreur 2 1 appelsys3 fin

// Quitte le programme avec le code de retour se
// trouvant en haut de la pile.
macro quitte 60 appelsys1 fin

macro dup2 enjambe enjambe fin

macro div divmod lâche fin
macro mod divmod permute lâche fin

macro charge64
    7 + 0
    8 << enjambe , + permute 1 - permute
    8 << enjambe , + permute 1 - permute
    8 << enjambe , + permute 1 - permute
    8 << enjambe , + permute 1 - permute
    8 << enjambe , + permute 1 - permute
    8 << enjambe , + permute 1 - permute
    8 << enjambe , + permute 1 - permute
    8 << enjambe , + permute lâche
fin

macro stocke64
    dup2 255 & . 8 >> permute 1 + permute
    dup2 255 & . 8 >> permute 1 + permute
    dup2 255 & . 8 >> permute 1 + permute
    dup2 255 & . 8 >> permute 1 + permute
    dup2 255 & . 8 >> permute 1 + permute
    dup2 255 & . 8 >> permute 1 + permute
    dup2 255 & . 8 >> permute 1 + permute
    dup2 255 & . lâche lâche
fin
