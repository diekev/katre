émets_instruction :: fonc (empl asm: *AssembleuseNASM, nom: chaine)
{
    ajoute_au_tampon(enchaineuse, "  ", nom, "\n")
}

émets_instruction :: fonc (empl asm: *AssembleuseNASM, nom: chaine, op1: chaine)
{
    ajoute_au_tampon(enchaineuse, "  ", nom, " ", op1, "\n")
}

émets_instruction :: fonc (empl asm: *AssembleuseNASM, nom: chaine, op1: chaine, op2: chaine)
{
    ajoute_au_tampon(enchaineuse, "  ", nom, " ", op1, ", ", op2, "\n")
}

